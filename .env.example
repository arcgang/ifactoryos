# Local connection settings for the platform in docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085
MQTT_URL=mqtt://localhost:1883
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpassword
OIDC_ISSUER_URL=http://localhost:8090/default
OIDC_CLIENT_ID=local
OIDC_CLIENT_SECRET=local
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=local-root
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# audit_client / audit-client SDK — immutable audit log (Azure Blob WORM)
AUDIT_STORAGE_ACCOUNT=stauditlogdev
AUDIT_CONTAINER_NAME=audit-events
# vin-digital-thread-api — required role claim for service-to-service ingest callers
INGESTOR_ROLE=thread-ingestor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CITUS_URL=postgresql://postgres:local@localhost:5434/app
# edge-gateways smoke tests — SASL/SCRAM principal for DDATA topic writes
EDGE_GW_KAFKA_BOOTSTRAP=uns-kafka-bootstrap.confluent.svc.cluster.local:9092
EDGE_GW_KAFKA_USERNAME=edge-gw-smoke-user
EDGE_GW_KAFKA_PASSWORD=<read-from-vault>
# Azure / Entra ID — required by platform/bmw-entra-id Terraform module
ARM_CLIENT_ID=<service-principal-client-id>
ARM_CLIENT_SECRET=<service-principal-client-secret>
ARM_TENANT_ID=<azure-tenant-id>
# api-gateway — required by platform/api-gateway Terraform module
# TF_VAR_entra_tenant_id must match ARM_TENANT_ID above
TF_VAR_entra_tenant_id=<azure-tenant-id>
TF_VAR_audit_log_endpoint=https://audit.internal.ifos.example
# line-command SPA — AR Workbench station configuration (Vite client-side env)
VITE_STATION_ID=MARRIAGE-01
VITE_DEVICE_TYPE=HoloLens2
# VITE_API_URL is intentionally absent for prod (requests go same-origin via api-gateway)
# Set to http://localhost:3001 for local dev if running the API separately.
# line-command-api — AR instruction endpoint
ASSOCIATE_ROLE=ifos-associate
SHIFT_LEAD_ROLE=ifos-shiftlead
VDT_BASE_URL=http://vin-digital-thread-api:8001
VDT_TIMEOUT_SECONDS=10.0
FALLBACK_PDF_QR_URL_TEMPLATE=https://docs.internal.ifos.example/instructions/{vin}.pdf
CACHE_TTL_SECONDS=1800
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# line-command-api torque consumer — set to false to disable the Kafka consumer (e.g. in unit test environments)
TORQUE_CONSUMER_ENABLED=true
# uns-backbone DR smoke tests — Germany North Application Gateway + Kafka DR cluster
DR_BASE_URL=https://apigw-dr.ifos.bmwgroup.net
DR_SMOKE_TOKEN=<read-from-vault: secret/ifos/dr/smoke-test:token>
DR_CA_CERT=/etc/ssl/certs/ifos-dr-ca.crt
DR_KAFKA_REST=https://apigw-dr.ifos.bmwgroup.net/kafka-rest
DR_SCHEMA_REGISTRY_URL=https://apigw-dr.ifos.bmwgroup.net/schema-registry
DR_AI_SERVING_URL=https://apigw-dr.ifos.bmwgroup.net/ai-serving
DR_MQ_BOOTSTRAP=uns-kafka-dr-bootstrap.confluent.svc.cluster.local:9092
DR_MQ_SMOKE_USERNAME=smoke-test-user
DR_MQ_SMOKE_PASSWORD=<read-from-vault: secret/ifos/dr/kafka-smoke:password>
DR_RTO_BUDGET_SECONDS=14400
# uns-backbone DR Terraform variables
TF_VAR_primary_app_gateway_fqdn=<west-europe-appgw-fqdn>
TF_VAR_dr_app_gateway_fqdn=<germany-north-appgw-fqdn>
TF_VAR_traffic_manager_resource_group=glbl-pr-ifos-eude-rgp-backup
TF_VAR_pull_secret=<redhat-pull-secret-json>
# sequence-optimizer — constraint threshold API and breach-event consumer
CITUS_URL=postgresql://postgres:local@localhost:5434/app
CONSTRAINT_TELEMETRY_TOPIC=bmw.munich.i4.uns.constraints.live.v1
CONSTRAINT_ALERT_TOPIC=sequence.constraint.alert
CONSTRAINT_DLQ_TOPIC=uns.munich.i4.dlq.planning-cockpit-constraint-consumer
CONSTRAINT_CONSUMER_GROUP=planning-cockpit-constraint-consumer
THRESHOLD_WRITER_ROLE=constraint-threshold-writer
# sequence-optimizer — POST /optimize and GET /optimize/{runId} (US-002)
SEQUENCE_OPTIMIZED_TOPIC=bmw.munich.i4.sequence.optimized.v1
# sequence-optimizer — POST /resequence (US-005)
RESEQUENCE_TRIGGERED_TOPIC=sequence.resequence.triggered
RESEQUENCE_WRITER_ROLE=production-planner
# sequence-optimizer — MY26 config API (US-006)
MY26_CONFIG_ACTIVATED_TOPIC=uns.munich.i4.sequence.my26.config.activated.v1
MY26_CONFIG_WRITER_ROLE=production-planner
# sequence-optimizer — POST /overrides (US-003)
OVERRIDE_WRITER_ROLE=production-planner
SEQUENCE_OVERRIDE_APPLIED_TOPIC=bmw.munich.i4.sequence.override.applied.v1
KSERVE_ENDPOINT_URL=http://sequence-optimizer.kserve.svc.cluster.local/v1/models/sequence-optimizer:predict
KSERVE_TIMEOUT_S=43.0
KSERVE_CLIENT_ID=<read-from-vault: secret/ifos/kserve/sequence-optimizer:client_id>
KSERVE_CLIENT_SECRET=<read-from-vault: secret/ifos/kserve/sequence-optimizer:client_secret>
KSERVE_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
AUDIT_LOG_URL=http://audit-log.internal.svc.cluster.local/api/v1/audit/event
AUDIT_LOG_TIMEOUT_S=1.0
IDEMPOTENCY_CACHE_TTL_S=600
# spiffe-spire — SPIRE server and integration tests
SPIRE_SERVER_ADDRESS=spire-server.spire.svc.cluster.local:8081
SPIRE_AGENT_SOCKET=/run/spire/sockets/agent.sock
SPIRE_TRUST_BUNDLE_ENDPOINT=https://spire-server.spire.svc.cluster.local:8443/bundle
SPIRE_TRUST_BUNDLE_CA_CERT=/etc/ssl/certs/ifos-ca.crt
VAULT_SPIRE_CA_KEY_PATH=secret/data/spire/ca-key
# audit-forwarder — uns-backbone rejection-to-WORM service (platform/uns-backbone/forwarder/)
AUDIT_FORWARDER_CLIENT_ID=<azure-managed-identity-client-id>
# AUDIT_STORAGE_ACCOUNT and AUDIT_CONTAINER_NAME are shared with the audit_client SDK above
# edge-gateways mTLS tests — test_mtls_spiffe.py generates in-process certs; no vars needed.
# The below are for reference when running against a live SPIRE + HiveMQ stack.
EDGE_GW_MQTT_BROKER_HOST=uns-hivemq.hivemq.svc.cluster.local
EDGE_GW_MQTT_BROKER_PORT=8883
EDGE_GW_SPIRE_TRUST_DOMAIN=munich.bmw
# edge-gateways ADS torque reader — Avro schema registry (used at deploy time for schema registration)
# The schema ID returned by the registry is passed as ADS_TORQUE_SCHEMA_ID at runtime.
# test_ads_torque_reader.py does not require these — it uses a fixed test schema ID (42).
ADS_TORQUE_SCHEMA_REGISTRY_URL=https://uns-schema-registry.confluent.svc.cluster.local:8081
ADS_TORQUE_SCHEMA_ID=<schema-id-from-registry>
# edge-gateways MQTT Sparkplug B publisher (US-011) — SPIRE SVID paths (written by svid-watcher.service)
# No credentials are stored here; the SVID is fetched from the SPIRE Workload API socket.
SVID_CERT_PATH=/run/spire/svid/svid.pem
SVID_KEY_PATH=/run/spire/svid/svid_key.pem
SPIRE_BUNDLE_PATH=/run/spire/bundle/bundle.pem
# Local OT-network MQTT broker for AR overlay status signals (PENDING_SYNC / synced).
# Stays inside IEC 62443 SL2 zone; separate from UNS HiveMQ broker (no zone-boundary crossing).
EDGE_GW_OT_BROKER_HOST=localhost
EDGE_GW_OT_BROKER_PORT=1883
# uns-backbone mTLS / SPIRE CA bundle sidecar
# Path where spiffe-helper writes the spiffe://munich.bmw CA bundle PEM inside the HiveMQ pod.
HIVEMQ_SPIRE_CA_BUNDLE_PATH=/opt/hivemq/conf/spire-ca/bundle.pem
# Audit forwarder endpoint consumed by the HiveMQ rejection webhook extension.
HIVEMQ_REJECTION_AUDIT_ENDPOINT=http://audit-forwarder.uns-backbone.svc.cluster.local/rejections/mqtt
IDENTITY_SERVICE_PORT=8083
# identity-service — GDPR pseudonymisation mapping and Article 17 deletion (US-028/BR-13)
# On-prem Munich PostgreSQL/Citus (EU data residency); access restricted to identity_service ROLE only.
IDENTITY_DB_URL=postgresql://identity_service:localpassword@localhost:5434/app
# vin-digital-thread-api — PII pseudonymisation and EU residency
# URL of the bmw-entra-id identity service for employee ID → pseudonymous token lookups.
IDENTITY_SERVICE_URL=http://localhost:8083
IDENTITY_SERVICE_TIMEOUT_S=2.0
# UNS Kafka consumer settings
UNS_MANUFACTURING_TOPIC=factory.munich.uns.manufacturing.event.v1
UNS_CONSUMER_GROUP=vin-digital-thread-api-consumer
# EU residency allowlist for Neo4j: comma-separated hostnames/IP prefixes.
# Leave empty in local dev to disable the check.
# In production: set to Azure Germany West Central / West Europe / on-prem Munich FQDNs.
NEO4J_EU_HOST_ALLOWLIST=
# Managed Identity client ID for identity-service ARO pod (Azure Workload Identity)
IDENTITY_SERVICE_MI_CLIENT_ID=<azure-managed-identity-client-id>
# Sensitive Terraform variables for bmw-entra-id/identity_pseudonymisation.tf
# Injected by HashiCorp Vault agent at apply time — never hardcoded.
TF_VAR_identity_db_connection_string=<read-from-vault: secret/identity-service/db:connection_string>
TF_VAR_identity_service_db_password=<read-from-vault: secret/identity-service/db:password>
TF_VAR_identity_db_superuser_password=<read-from-vault: secret/identity-service/db:superuser_password>
# observability-stack adoption event pipeline — US-019 · BR-12
# OTel Collector → Azure Monitor Log Analytics workspace law-ifos-euwe-pr
ARM_SUBSCRIPTION_ID=<azure-subscription-id>
TF_VAR_azure_subscription_id=<azure-subscription-id>
# Azure Monitor workspace credentials — injected by Vault agent into the
# otel-collector-azmon-credentials Kubernetes secret (never set directly).
AZURE_MONITOR_WORKSPACE_ID=<read-from-vault: secret/otel/azmon:workspace_id>
AZURE_MONITOR_SHARED_KEY=<read-from-vault: secret/otel/azmon:shared_key>
# Grafana Azure Monitor datasource — Log Analytics workspace ID for adoption.json panels
AZURE_LAW_WORKSPACE_ID=<azure-log-analytics-workspace-resource-id>
# opcenter-sync-service — gate result ingestion and read API (US-017)
# PostgreSQL (Citus) — shared CITUS_URL above applies
QUALITY_GATE_VALIDATOR_ROLE=quality-gate-validator
GATE_RESULT_TIMEOUT_SECONDS=600
# Confluent Schema Registry — shared SCHEMA_REGISTRY_URL above applies
# Kafka — shared KAFKA_BOOTSTRAP_SERVERS, KAFKA_SASL_USERNAME, KAFKA_SASL_PASSWORD above apply
