# Local connection settings for the platform in docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085
MQTT_URL=mqtt://localhost:1883
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpassword
OIDC_ISSUER_URL=http://localhost:8090/default
OIDC_CLIENT_ID=local
OIDC_CLIENT_SECRET=local
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=local-root
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# audit_client / audit-client SDK — immutable audit log (Azure Blob WORM)
AUDIT_STORAGE_ACCOUNT=stauditlogdev
AUDIT_CONTAINER_NAME=audit-events
# vin-digital-thread-api — required role claim for service-to-service ingest callers
INGESTOR_ROLE=thread-ingestor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CITUS_URL=postgresql://postgres:local@localhost:5434/app
# edge-gateways smoke tests — SASL/SCRAM principal for DDATA topic writes
EDGE_GW_KAFKA_BOOTSTRAP=uns-kafka-bootstrap.confluent.svc.cluster.local:9092
EDGE_GW_KAFKA_USERNAME=edge-gw-smoke-user
EDGE_GW_KAFKA_PASSWORD=<read-from-vault>
# Azure / Entra ID — required by platform/bmw-entra-id Terraform module
ARM_CLIENT_ID=<service-principal-client-id>
ARM_CLIENT_SECRET=<service-principal-client-secret>
ARM_TENANT_ID=<azure-tenant-id>
# api-gateway — required by platform/api-gateway Terraform module
# TF_VAR_entra_tenant_id must match ARM_TENANT_ID above
TF_VAR_entra_tenant_id=<azure-tenant-id>
TF_VAR_audit_log_endpoint=https://audit.internal.ifos.example
# uns-backbone DR smoke tests — Germany North Application Gateway + Kafka DR cluster
DR_BASE_URL=https://apigw-dr.ifos.bmwgroup.net
DR_SMOKE_TOKEN=<read-from-vault: secret/ifos/dr/smoke-test:token>
DR_CA_CERT=/etc/ssl/certs/ifos-dr-ca.crt
DR_KAFKA_REST=https://apigw-dr.ifos.bmwgroup.net/kafka-rest
DR_SCHEMA_REGISTRY_URL=https://apigw-dr.ifos.bmwgroup.net/schema-registry
DR_AI_SERVING_URL=https://apigw-dr.ifos.bmwgroup.net/ai-serving
DR_MQ_BOOTSTRAP=uns-kafka-dr-bootstrap.confluent.svc.cluster.local:9092
DR_MQ_SMOKE_USERNAME=smoke-test-user
DR_MQ_SMOKE_PASSWORD=<read-from-vault: secret/ifos/dr/kafka-smoke:password>
DR_RTO_BUDGET_SECONDS=14400
# uns-backbone DR Terraform variables
TF_VAR_primary_app_gateway_fqdn=<west-europe-appgw-fqdn>
TF_VAR_dr_app_gateway_fqdn=<germany-north-appgw-fqdn>
TF_VAR_traffic_manager_resource_group=glbl-pr-ifos-eude-rgp-backup
TF_VAR_pull_secret=<redhat-pull-secret-json>
