# Base URL for the planning-cockpit API gateway (no trailing slash).
# Leave empty in development to use relative paths (proxied via vite.config.ts).
VITE_API_URL=https://api.planning-cockpit.factory-os.bmw.int

# OTLP/HTTP collector endpoint for adoption instrumentation events.
# Proxied through the API gateway to avoid CORS; falls back to /api/v1/ingest/events.
VITE_OTLP_ENDPOINT=https://api.planning-cockpit.factory-os.bmw.int/api/v1/ingest/events
