# quality-studio SPA — environment variables
# All are Vite public vars (VITE_ prefix), read at build time.

# Base URL for the Quality Studio API (opcenter-sync-service / gateway)
# In production this is injected by the ARO deployment manifest.
# Example: https://api.factoryos.internal
VITE_API_URL=https://api-gateway.internal/quality-studio

# OTLP HTTP endpoint for adoption event emission (proxied via api-gateway)
# Falls back to /api/v1/telemetry/adoption when not set
VITE_OTLP_ENDPOINT=/api/v1/ingest/events

# SSE endpoint for real-time DefectGenome cluster-alert push events
# Proxied through the api-gateway; falls back to /api/v1/defect-genome/events
VITE_SSE_URL=https://api-gateway.internal/quality-studio/api/v1/defect-genome/events
