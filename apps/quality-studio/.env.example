# Base URL for the Quality Studio API (opcenter-sync-service / gateway)
# Example: https://api.factoryos.internal
VITE_API_URL=https://api.factoryos.example

# OTLP adoption-event endpoint (best-effort, fire-and-forget)
# Falls back to /api/v1/telemetry/adoption when not set
VITE_OTLP_ENDPOINT=https://telemetry.factoryos.example/api/v1/telemetry/adoption
