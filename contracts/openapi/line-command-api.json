{
  "info": {
    "title": "line-command-api",
    "version": "1.0.0",
    "description": "Backend API for Line Command console — serves AR work instructions, torque log submission, and shift handover for Assembly Associates and Shift Leads at BMW Munich i4."
  },
  "paths": {
    "/handover": {
      "post": {
        "tags": [
          "Shift Handover"
        ],
        "summary": "Submit a structured digital shift handover",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoverResponse"
                }
              }
            },
            "description": "Handover submitted successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid handover payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Caller does not have shift-lead role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Handover already submitted for this shift (idempotency)"
          }
        },
        "description": "Creates a shift handover record linking open Andon alert dispositions, OEE delta, and held VINs. Emits HANDOVER_SUBMITTED adoption event. Satisfies AC-e37bcf34, AC-5f4b73cb, AC-04cd3711, AC-fd1f00c6.",
        "operationId": "submitHandover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HandoverRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/handovers": {
      "get": {
        "tags": [
          "Shift Handover"
        ],
        "summary": "List shift handover records (paginated)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoverListResponse"
                }
              }
            },
            "description": "Paginated list of handover records"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query parameters"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "lineId",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "fromTs",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "toTs",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "description": "Returns cursor-paginated handover records. Used by incoming Shift Lead and Plant Manager daily review. Satisfies AC-5f4b73cb, AC-04cd3711.",
        "operationId": "listHandovers"
      }
    },
    "/torque/log": {
      "post": {
        "tags": [
          "Torque Log"
        ],
        "summary": "Submit a torque tightening record from the Beckhoff PLC via edge gateway",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TorqueLogResponse"
                }
              }
            },
            "description": "Torque log accepted and forwarded to UNS"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TorqueLogResponse"
                }
              }
            },
            "description": "Torque log accepted but UNS publish pending (edge-buffered scenario)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid torque log payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Duplicate torque log (idempotency key already processed)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TorqueOutOfToleranceResponse"
                }
              }
            },
            "description": "Torque value out of tolerance — alert raised"
          }
        },
        "description": "Accepts a torque/angle trace record for a VIN fastener point. Validates against VIN option-code tolerance, writes to torque_log table, forwards to UNS, and emits adoption event. Satisfies AC-13685a24, AC-69c77dfd, AC-b734032a, AC-fd1f00c6.",
        "operationId": "submitTorqueLog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TorqueLogRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/ar/sessions": {
      "post": {
        "tags": [
          "AR Instructions"
        ],
        "summary": "Record the start of an AR Workbench session for adoption instrumentation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArSessionStartResponse"
                }
              }
            },
            "description": "AR session event recorded"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "description": "Emits an AR_SESSION_START adoption event. Must include VIN, device type, and station ID. No biometric or gaze data. Satisfies AC-9c6cd996 and AC-fd1f00c6.",
        "operationId": "startArSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArSessionStartRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/torque/logs": {
      "get": {
        "tags": [
          "Torque Log"
        ],
        "summary": "List torque log records for a VIN or station (paginated)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TorqueLogListResponse"
                }
              }
            },
            "description": "Paginated list of torque log records"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query parameters"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "vin",
            "schema": {
              "type": "string",
              "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "stationId",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "description": "Returns cursor-paginated torque log records. Used by Shift Lead and Quality Studio for traceability review.",
        "operationId": "listTorqueLogs"
      }
    },
    "/ar/expert-calls": {
      "post": {
        "tags": [
          "AR Instructions"
        ],
        "summary": "Initiate a remote expert call from the AR Workbench",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpertCallResponse"
                }
              }
            },
            "description": "Expert call session created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "description": "Creates an expert call session record. Returns call mode (video/voice) based on Works Council approval flag. Satisfies AC-7293efd6, AC-48bbc2a6.",
        "operationId": "initiateExpertCall",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpertCallRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/ar/instructions/{vin}": {
      "get": {
        "tags": [
          "AR Instructions"
        ],
        "summary": "Retrieve VIN-specific AR holographic work instruction overlay",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArInstructionResponse"
                }
              }
            },
            "description": "VIN-specific AR instruction overlay"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid VIN or missing required query parameters"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Caller does not have the assembly-associate or shift-lead role"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VIN not found in digital thread"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArInstructionFallbackResponse"
                }
              }
            },
            "description": "Upstream digital thread or instruction store did not respond within timeout; fallback payload included"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "vin",
            "schema": {
              "type": "string",
              "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
            },
            "required": true,
            "description": "17-character Vehicle Identification Number"
          },
          {
            "in": "query",
            "name": "stationId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Station identifier (e.g. MARRIAGE-01, FINAL-02)"
          },
          {
            "in": "query",
            "name": "deviceType",
            "schema": {
              "enum": [
                "HoloLens2",
                "iPad"
              ],
              "type": "string"
            },
            "required": true,
            "description": "AR device type for overlay rendering"
          }
        ],
        "description": "Returns the full work instruction payload for the given VIN including option codes, torque specifications, step sequence, variant delta indicators, and a fallback PDF QR code URL. Must respond within 5 s at p95 to satisfy AC-00bc6b07.",
        "operationId": "getArInstructions"
      }
    },
    "/handovers/{handoverId}": {
      "get": {
        "tags": [
          "Shift Handover"
        ],
        "summary": "Retrieve a single shift handover record by ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoverRecord"
                }
              }
            },
            "description": "Handover record"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Handover not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "handoverId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "description": "Returns the full handover record including alert dispositions, OEE delta, and held VINs. Satisfies AC-5f4b73cb, AC-04cd3711.",
        "operationId": "getHandover"
      }
    },
    "/line-command/andon/alerts": {
      "get": {
        "tags": [
          "Andon Alerts"
        ],
        "summary": "List open predictive Andon alerts for the current shift (paginated)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AndonAlertListResponse"
                }
              }
            },
            "description": "Paginated list of Andon alerts"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query parameters"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "shiftId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "open",
                "resolved",
                "escalated",
                "monitoring"
              ],
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "lineId",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "description": "Returns cursor-paginated open Andon alerts. Used by Handover Builder to pre-populate alert line items. Satisfies AC-e37bcf34.",
        "operationId": "listAndonAlerts"
      }
    },
    "/ar/expert-calls/{callId}/end": {
      "post": {
        "tags": [
          "AR Instructions"
        ],
        "summary": "End a remote expert call and log the session to the VIN digital thread audit trail",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpertCallEndResponse"
                }
              }
            },
            "description": "Expert call ended and logged"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Call session not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "callId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "description": "Closes the call session and writes call duration, VIN, station ID, call mode, and expert user ID to the audit trail. No biometric or gaze data. Satisfies AC-e30375d9.",
        "operationId": "endExpertCall",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpertCallEndRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/andon/alerts/{alertId}/acknowledge": {
      "post": {
        "tags": [
          "Andon Alerts"
        ],
        "summary": "Acknowledge a predictive Andon alert and record disposition",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertAcknowledgeResponse"
                }
              }
            },
            "description": "Alert acknowledged"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid disposition value"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Caller does not have shift-lead role"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Alert not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Alert already acknowledged"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "description": "Records the Shift Lead's disposition (resolved/escalated/monitoring) for an alert. Emits ALERT_ACKNOWLEDGED adoption event. Satisfies AC-fd1f00c6.",
        "operationId": "acknowledgeAndonAlert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertAcknowledgeRequest"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://line-command-api.internal.bmw-ifos.eu/api/v1",
      "description": "Production (ARO Germany West Central)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AndonAlert": {
        "type": "object",
        "required": [
          "alertId",
          "shiftId",
          "lineId",
          "stationId",
          "alertType",
          "status",
          "predictedFailureTs",
          "createdAt"
        ],
        "properties": {
          "lineId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "escalated",
              "monitoring"
            ],
            "type": "string"
          },
          "alertId": {
            "type": "string",
            "format": "uuid"
          },
          "shiftId": {
            "type": "string",
            "format": "uuid"
          },
          "alertType": {
            "type": "string",
            "description": "e.g. ELECTRODE_WEAR, PRESS_DIE_OVERRUN, AGV_DELAY"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "stationId": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "resolved",
              "escalated",
              "monitoring"
            ],
            "type": "string",
            "nullable": true
          },
          "acknowledgedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "dispositionNote": {
            "type": "string",
            "nullable": true
          },
          "predictedFailureTs": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledgedByUserId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "required": [
          "next_cursor",
          "limit"
        ],
