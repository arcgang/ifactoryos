{
  "info": {
    "title": "Sequence Optimizer API",
    "version": "1.0.0",
    "description": "Monte Carlo VIN sequence optimisation service for BMW Munich i4 line. Provides optimisation runs, constraint explanation, override logging, disruption alerting, and MY26 configuration management."
  },
  "paths": {
    "/alerts": {
      "get": {
        "summary": "List active and recent constraint breach alerts (cursor-paginated)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            },
            "description": "Paginated alert list"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "active",
                "acknowledged",
                "resolved",
                "all"
              ],
              "type": "string",
              "default": "active"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listAlerts"
      }
    },
    "/optimize": {
      "post": {
        "summary": "Trigger a 50-run Monte Carlo optimisation and return a ranked VIN sequence",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            },
            "description": "Optimisation completed (Monte Carlo or heuristic fallback)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Insufficient role"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Constraint model validation failure (e.g. unknown option code)"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Optimisation timed out; heuristic fallback was not available"
          }
        },
        "description": "Accepts a list of VINs and live constraint snapshot. Executes 50 Monte Carlo runs via KServe. Returns ranked sequence within 45 s; falls back to rule-based heuristic if timeout or model error occurs.",
        "operationId": "runOptimizer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/overrides": {
      "get": {
        "summary": "List override log entries for a given week (cursor-paginated)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverrideListResponse"
                }
              }
            },
            "description": "Paginated override log"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "weekIso",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
            },
            "required": false,
            "description": "ISO week string e.g. 2025-W30; defaults to current week"
          },
          {
            "in": "query",
            "name": "runId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listOverrides"
      },
      "post": {
        "summary": "Record a manual VIN position override with planner justification",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverrideRecord"
                }
              }
            },
            "description": "Override recorded"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error (e.g. justification < 10 chars)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Insufficient role"
          }
        },
        "operationId": "createOverride",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverrideRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/resequence": {
      "post": {
        "summary": "Trigger a targeted Monte Carlo re-sequence for a subset of affected VINs (mid-week disruption)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            },
            "description": "Re-sequence result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Insufficient role"
          }
        },
        "operationId": "runTargetedResequence",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResequenceRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/my26/config": {
      "get": {
        "summary": "Retrieve the current MY26 constraint model configuration",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/My26Config"
                }
              }
            },
            "description": "MY26 configuration"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No MY26 config exists yet"
          }
        },
        "operationId": "getMy26Config"
      }
    },
    "/model/health": {
      "get": {
        "summary": "Return KServe model health, active model version, and shadow-mode heuristic status",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelHealth"
                }
              }
            },
            "description": "Model health status"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          }
        },
        "operationId": "getModelHealth"
      }
    },
    "/my26/config/save": {
      "post": {
        "summary": "Save a validated MY26 configuration; activates for subsequent optimizer runs",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/My26Config"
                }
              }
            },
            "description": "MY26 configuration saved and activated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation failed; config not saved"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Insufficient role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict — unresolved validation errors must be fixed before saving"
          }
        },
        "operationId": "saveMy26Config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/My26ConfigDraft"
              }
            }
          },
          "required": true
        }
      }
    },
    "/optimize/{runId}": {
      "get": {
        "summary": "Retrieve a previously completed optimisation run by ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            },
            "description": "Optimisation run result"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Run not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "runId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "operationId": "getOptimizeRun"
      }
    },
    "/overrides/export": {
      "get": {
        "summary": "Export override log for a given week as PDF (for Plant Director review)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "description": "PDF binary"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid week parameter"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "weekIso",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
            },
            "required": true
          }
        ],
        "operationId": "exportOverridesPdf"
      }
    },
    "/my26/config/validate": {
      "post": {
        "summary": "Validate new MY26 option codes and paint palette against the constraint model without saving",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/My26ValidationResult"
                }
              }
            },
            "description": "Validation result with any conflicts or missing mappings"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Malformed payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthenticated"
          }
        },
        "operationId": "validateMy26Config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/My26ConfigDraft"
              }
            }
          },
          "required": true
        }
      }
    },
    "/constraints/thresholds": {
