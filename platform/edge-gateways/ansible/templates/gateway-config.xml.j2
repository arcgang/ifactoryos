<?xml version="1.0" encoding="UTF-8"?>
<!--
  Siemens SIMATIC Edge Runtime — gateway configuration
  Generated by Ansible for: {{ inventory_hostname }}
  Shop: {{ shop }} | Role: {{ gateway_role }}

  SVID cert is rotated in-place by the SPIRE agent; the runtime inotify-watches
  {{ svid_cert_path }} and {{ svid_key_path }} and reloads the TLS context without
  dropping active MQTT sessions (zero-interrupt rotation).
-->
<EdgeGatewayConfig>

  <!-- ======================================================================
       Data Sources — Beckhoff ADS/ADS-UDP process data objects
       ====================================================================== -->
  <DataSources>
{% for plc in plc_group %}
    <AdsDataSource>
      <Id>{{ plc.plc_id }}</Id>
      <AmsNetId>{{ plc.ads_net_id }}</AmsNetId>
      <Port>{{ ads_port }}</Port>
      <Protocol>ADS-UDP</Protocol>
      <Tags>
{% for tag in plc.tags %}
        <Tag>
          <Name>{{ tag.name }}</Name>
          <AdsSymbol>{{ tag.ads_symbol }}</AdsSymbol>
          <DataType>{{ tag.data_type }}</DataType>
          <SampleRateMs>{{ tag.sample_rate_ms }}</SampleRateMs>
{% if tag.unit is defined %}
          <Unit>{{ tag.unit }}</Unit>
{% endif %}
          <!-- Change-of-value: only publish if value changed by more than cov_threshold_pct % -->
          <CovThresholdPct>{{ ads_cov_threshold_pct }}</CovThresholdPct>
        </Tag>
{% endfor %}
      </Tags>
    </AdsDataSource>
{% endfor %}
  </DataSources>

  <!-- ======================================================================
       MQTT Sparkplug B publisher
       ====================================================================== -->
  <MqttPublisher>
    <BrokerUri>mqtts://{{ mqtt_broker_host }}:{{ mqtt_broker_port }}</BrokerUri>

    <!-- Sparkplug B namespace elements -->
    <SparkplugNamespace>{{ sparkplug_version }}</SparkplugNamespace>
    <GroupId>{{ mqtt_group_id }}</GroupId>
    <!-- edge_node_id = this gateway's inventory hostname (e.g. edge-assembly-01) -->
    <EdgeNodeId>{{ inventory_hostname }}</EdgeNodeId>

    <!-- Device IDs derived from PLC IDs (one Sparkplug B device per PLC) -->
    <Devices>
{% for plc in plc_group %}
      <Device>
        <DeviceId>{{ plc.plc_id }}</DeviceId>
        <DataSourceId>{{ plc.plc_id }}</DataSourceId>
      </Device>
{% endfor %}
    </Devices>

    <!-- QoS 1 — at-least-once, matching HiveMQ max-qos -->
    <QoS>{{ mqtt_qos }}</QoS>

    <!-- STATE and BIRTH certificates on connect/reconnect (Sparkplug B spec §6) -->
    <PublishBirthOnConnect>{{ sparkplug_publish_birth_on_connect | lower }}</PublishBirthOnConnect>
    <PublishDeathOnDisconnect>{{ sparkplug_publish_death_on_disconnect | lower }}</PublishDeathOnDisconnect>

    <!-- mTLS — SPIFFE/SPIRE SVID; inotify-watched for zero-interrupt rotation -->
    <TLS>
      <Version>{{ tls_version }}</Version>
      <CipherSuites>
{% for cs in tls_cipher_suites %}
        <CipherSuite>{{ cs }}</CipherSuite>
{% endfor %}
      </CipherSuites>
      <CertificatePath>{{ svid_cert_path }}</CertificatePath>
      <PrivateKeyPath>{{ svid_key_path }}</PrivateKeyPath>
      <CaBundlePath>{{ spire_bundle_path }}</CaBundlePath>
      <!-- Reload TLS context on certificate file change without session drop -->
      <HotReload>true</HotReload>
      <HotReloadWatchIntervalMs>5000</HotReloadWatchIntervalMs>
    </TLS>

    <!-- Reconnect with exponential back-off -->
    <Reconnect>
      <InitialDelayMs>{{ mqtt_reconnect_delay_ms }}</InitialDelayMs>
      <MaxDelayMs>{{ mqtt_reconnect_max_delay_ms }}</MaxDelayMs>
      <BackoffMultiplier>2.0</BackoffMultiplier>
    </Reconnect>
  </MqttPublisher>

  <!-- ======================================================================
       Store-and-forward buffer — 60 s of telemetry on connectivity loss.
       Messages are replayed in chronological order (seq ascending) on reconnect.
       ====================================================================== -->
  <StoreAndForward>
    <Enabled>true</Enabled>
    <BufferDir>{{ simatic_edge_data_dir }}/buffer</BufferDir>
    <!-- 60 seconds at peak tag rate; size is auto-tuned by the runtime -->
    <MaxBufferSeconds>{{ mqtt_buffer_seconds }}</MaxBufferSeconds>
    <!-- Replay in chronological order (oldest first) -->
    <ReplayOrder>FIFO</ReplayOrder>
    <!-- Throttle replay to avoid flooding the broker after reconnect -->
    <ReplayRateLimitMsgPerSec>5000</ReplayRateLimitMsgPerSec>
  </StoreAndForward>

  <!-- ======================================================================
       Observability
       ====================================================================== -->
  <Logging>
    <Dir>{{ simatic_edge_log_dir }}</Dir>
    <Level>INFO</Level>
    <MaxFileSizeMb>100</MaxFileSizeMb>
    <MaxFiles>10</MaxFiles>
  </Logging>

  <Metrics>
    <!-- Prometheus exposition on :9100/metrics — scraped by observability-stack -->
    <PrometheusPort>9100</PrometheusPort>
    <Labels>
      <shop>{{ shop }}</shop>
      <node_id>{{ inventory_hostname }}</node_id>
      <role>{{ gateway_role }}</role>
    </Labels>
  </Metrics>

</EdgeGatewayConfig>
