# Environment variables required to run the edge-gateways integration tests.
# Copy to .env and fill in real values; never commit real credentials.

# Kafka bootstrap for the test producer/consumer (from uns-backbone output)
EDGE_GW_KAFKA_BOOTSTRAP=uns-kafka-bootstrap.confluent.svc.cluster.local:9092

# SASL/SCRAM credentials for the test principal (read from Vault)
EDGE_GW_KAFKA_USERNAME=edge-gw-smoke-user
EDGE_GW_KAFKA_PASSWORD=<read-from-vault>
