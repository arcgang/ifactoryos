# Environment variables required to run the spiffe-spire integration tests.
# Copy to .env and fill in real values; never commit real credentials.

# SPIRE server gRPC address (host:port)
SPIRE_SERVER_ADDRESS=spire-server.spire.svc.cluster.local:8081

# Path to the SPIRE agent Unix socket (inside the test pod)
SPIRE_AGENT_SOCKET=/run/spire/sockets/agent.sock

# SPIRE trust bundle HTTPS endpoint
SPIRE_TRUST_BUNDLE_ENDPOINT=https://spire-server.spire.svc.cluster.local:8443/bundle

# Optional: path to CA cert bundle for verifying the trust bundle endpoint TLS
SPIRE_TRUST_BUNDLE_CA_CERT=/etc/ssl/certs/ifos-ca.crt

# MQTT broker for criterion (b) SVID rotation / live-connection test
MQTT_BROKER_HOST=uns-hivemq.hivemq.svc.cluster.local
MQTT_BROKER_PORT=8883

# Paths to TLS credentials injected by the SPIRE agent for the test workload
# These are the SVID cert/key written to the test pod's filesystem by the Workload API
MQTT_CLIENT_CERT_PATH=/run/spire/svid/tls.crt
MQTT_CLIENT_KEY_PATH=/run/spire/svid/tls.key
MQTT_CA_CERT_PATH=/run/spire/bundle/bundle.pem

# OT-zone test stub DNS name/IP and port (for criterion c reachability test)
OT_ZONE_STUB_HOST=ot-zone-test-stub.edge-gateways.svc.cluster.local
OT_ZONE_STUB_PORT=9090

# spire-agent CLI binary (installed in the integration-test image)
SPIRE_AGENT_BIN=spire-agent
