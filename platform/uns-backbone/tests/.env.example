# Environment variables required to run the uns-backbone smoke tests.
# Copy to .env and fill in real values; never commit real credentials.

# Kafka bootstrap for smoke test producer/consumer
UNS_KAFKA_BOOTSTRAP=uns-kafka-bootstrap.confluent.svc.cluster.local:9092

# SASL/SCRAM credentials for the smoke-test principal (read from Vault)
KAFKA_SMOKE_USERNAME=smoke-test-user
KAFKA_SMOKE_PASSWORD=<read-from-vault>

# Confluent Schema Registry
UNS_SCHEMA_REGISTRY_URL=https://uns-schema-registry.confluent.svc.cluster.local:8081

# Alertmanager endpoint and optional CA bundle path
UNS_ALERTMANAGER_URL=https://alertmanager.ifos.munich.internal/api/v2/alerts
UNS_ALERTMANAGER_CA_CERT=/etc/ssl/certs/ifos-ca.crt
