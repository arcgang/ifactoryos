# Environment variables for the uns-backbone mTLS integration tests.
# Copy to .env and fill in real values; never commit real credentials.
# Used by platform/uns-backbone/tests/integration/test_mtls_e2e.py

# HiveMQ broker — mTLS endpoint in the test namespace
HIVEMQ_HOST=hivemq.uns-backbone-test.svc.cluster.local
HIVEMQ_MTLS_PORT=8883

# Path to the HiveMQ server CA certificate (PEM) for client-side TLS verification.
# When generated locally: path to pki/ca.pem from generate_test_ca.py.
HIVEMQ_SERVER_CA_CERT=/etc/ssl/certs/ifos-ca.crt

# Kafka bootstrap — test namespace
KAFKA_BOOTSTRAP=kafka.uns-backbone-test.svc.cluster.local:9092

# SASL/SCRAM credentials for opcenter-sync-service (read from Vault in CI)
KAFKA_OPCENTER_USERNAME=opcenter-sync-service
KAFKA_OPCENTER_PASSWORD=<read-from-vault: secret/ifos/test/kafka-opcenter:password>

# Path to the Kafka broker CA certificate (PEM)
KAFKA_CA_CERT_PATH=/etc/ssl/certs/ifos-ca.crt

# SASL/SCRAM credentials for quality-studio (read from Vault in CI)
KAFKA_QUALITY_USERNAME=quality-studio
KAFKA_QUALITY_PASSWORD=<read-from-vault: secret/ifos/test/kafka-quality:password>

# Audit forwarder — HTTP endpoint in the test namespace
AUDIT_FORWARDER_URL=http://audit-forwarder.uns-backbone-test.svc.cluster.local

# Azurite WORM blob storage — test namespace
# Azurite default devstoreaccount1 well-known key is intentional for local dev only.
AZURITE_ACCOUNT_URL=http://azurite.uns-backbone-test.svc.cluster.local:10000/devstoreaccount1
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite.uns-backbone-test.svc.cluster.local:10000/devstoreaccount1;
WORM_CONTAINER=audit-events
