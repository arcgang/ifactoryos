# hyperledger-fabric-api — environment variables
# Copy to .env for local development. Never commit a .env with real credentials.

# JWT / OIDC (BMW Entra ID)
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<app-registration-client-id>

# RBAC role names (must match BMW Entra ID app role manifests)
CERTIFICATE_ISSUER_ROLE=CERTIFICATE_ISSUER
CERTIFICATE_READER_ROLE=CERTIFICATE_READER

# PostgreSQL (Citus — Vault Agent Injector injects credentials in production)
CITUS_URL=postgresql://postgres:local@localhost:5434/app

# Kafka (SASL/SCRAM-SHA-512 in production; leave empty for local plaintext)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Hyperledger Fabric peer (Vault Agent Injector injects TLS certs in production)
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_TLS_CERT_PATH=/var/run/secrets/fabric/tls.crt
FABRIC_CLIENT_CERT_PATH=/var/run/secrets/fabric/client.crt
FABRIC_CLIENT_KEY_PATH=/var/run/secrets/fabric/client.key
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=certificate
FABRIC_TRANSACTION_TIMEOUT_SECONDS=55.0
