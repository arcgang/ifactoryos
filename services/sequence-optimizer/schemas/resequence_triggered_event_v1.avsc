{
  "type": "record",
  "name": "ResequenceTriggeredEvent",
  "namespace": "bmw.munich.i4.sequence",
  "doc": "Published when a targeted mid-week re-sequence run completes.",
  "fields": [
    {
      "name": "runId",
      "type": "string",
      "doc": "UUID of the re-sequence optimisation run."
    },
    {
      "name": "alertId",
      "type": "string",
      "doc": "UUID of the constraint_alert that triggered this re-sequence."
    },
    {
      "name": "weekIso",
      "type": "string",
      "doc": "ISO week string (e.g. 2026-W42) for which the sequence was re-computed."
    },
    {
      "name": "resultType",
      "type": {
        "type": "enum",
        "name": "ResultType",
        "symbols": ["monte_carlo", "heuristic_fallback"]
      },
      "doc": "Indicates whether the result came from Monte Carlo or the rule-based heuristic fallback."
    },
    {
      "name": "affectedVins",
      "type": {
        "type": "array",
        "items": "string"
      },
      "doc": "VINs that were included in the targeted re-sequence."
    },
    {
      "name": "rankedSequence",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "RankedVin",
          "fields": [
            { "name": "vin",             "type": "string" },
            { "name": "position",        "type": "int" },
            { "name": "constraintScore", "type": "double" },
            { "name": "vipPriority",     "type": ["null", "boolean"], "default": null },
            { "name": "regulatoryHold",  "type": ["null", "boolean"], "default": null }
          ]
        }
      },
      "doc": "Ranked VIN sequence for the re-sequenced subset."
    },
    {
      "name": "confidenceScore",
      "type": "double",
      "doc": "Confidence score in [0, 1]."
    },
    {
      "name": "durationMs",
      "type": "int",
      "doc": "Total wall-clock time of the re-sequence run in milliseconds."
    },
    {
      "name": "completedAt",
      "type": "string",
      "doc": "ISO-8601 UTC timestamp when the re-sequence completed."
    },
    {
      "name": "source",
      "type": "string",
      "doc": "Originating system that triggered the re-sequence (e.g. 'planning-cockpit')."
    },
    {
      "name": "my26ConfigVersion",
      "type": ["null", "string"],
      "default": null,
      "doc": "MY26 config version UUID, if applicable."
    }
  ]
}
